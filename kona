<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Erase Reveal Image</title>
    <style>
        html, body { height: 100%; margin: 0; }
        body { overflow: hidden; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }

        /* ✅ 아래(드러날) 배경: 링크 이미지로 교체 */
        .scene {
            position: fixed;
            inset: 0;
            background: url("https://image-cdn.hypb.st/https%3A%2F%2Fkr.hypebeast.com%2Ffiles%2F2022%2F12%2FHyundai-unveil-the-all-new-kona-image-spec-info-1.jpg?q=75&w=1600&cbr=1&fit=max")
            center / cover no-repeat;
            background-color: #000; /* 이미지 로딩 전 대비 */
        }

        /* 위 덮개 캔버스 */
        #cover {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            cursor: crosshair;
            touch-action: none;
        }

        /* UI */
        .ui {
            position: fixed;
            left: 20px;
            bottom: 20px;
            display: flex;
            gap: 10px;
            align-items: center;
            padding: 10px 12px;
            border-radius: 14px;
            background: rgba(0,0,0,0.35);
            color: rgba(255,255,255,0.9);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            user-select: none;
        }

        .ui button {
            appearance: none;
            border: 1px solid rgba(255,255,255,0.25);
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.92);
            padding: 8px 10px;
            border-radius: 12px;
            cursor: pointer;
        }
        .ui button:hover { background: rgba(255,255,255,0.14); }

        .ui label { display:flex; align-items:center; gap:8px; font-size: 13px; }
        .ui input[type="range"] { width: 140px; }

        .hint {
            position: fixed;
            top: 18px;
            left: 50%;
            transform: translateX(-50%);
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(0,0,0,0.35);
            color: rgba(255,255,255,0.9);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            font-size: 14px;
            user-select: none;
            pointer-events: none;
        }
    </style>
</head>
<body>
<div class="scene" aria-hidden="true"></div>
<canvas id="cover"></canvas>

<div class="hint">마우스로 긁으면 이미지가 드러납니다 ✨</div>

<div class="ui">
    <button id="resetBtn">Reset</button>
    <label>
        Brush
        <input id="brush" type="range" min="10" max="140" value="60" />
        <span id="brushVal">60</span>
    </label>
    <label>
        Soft
        <input id="soft" type="range" min="0" max="1" step="0.01" value="0.35" />
        <span id="softVal">0.35</span>
    </label>
</div>

<script>
    const canvas = document.getElementById('cover');
    const ctx = canvas.getContext('2d');

    const brushEl = document.getElementById('brush');
    const softEl = document.getElementById('soft');
    const brushValEl = document.getElementById('brushVal');
    const softValEl = document.getElementById('softVal');
    const resetBtn = document.getElementById('resetBtn');

    let dpr = Math.max(1, window.devicePixelRatio || 1);
    let w = 0, h = 0;

    // ✅ 덮개 이미지는 안 씀(비워둬도 됨). 덮개는 캔버스가 직접 그림.
    const imageCoverUrl = "";
    let coverImg = null;

    function resize() {
        dpr = Math.max(1, window.devicePixelRatio || 1);
        w = Math.floor(window.innerWidth);
        h = Math.floor(window.innerHeight);
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        canvas.style.width = w + 'px';
        canvas.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        drawCover();
    }

    function drawCover() {
        ctx.globalCompositeOperation = 'source-over';
        ctx.clearRect(0, 0, w, h);

        // 1) ✅ 덮개를 "완전 불투명"으로 채움
        const g = ctx.createLinearGradient(0, 0, w, h);
        g.addColorStop(0, '#111827');
        g.addColorStop(0.5, '#0f172a');
        g.addColorStop(1, '#020617');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, w, h);

        // 2) ✅ 노이즈는 putImageData로 "덮어쓰기"가 아니라 "얹기"
        const noise = ctx.createImageData(w, h);
        const data = noise.data;
        const strength = 18;

        for (let i = 0; i < data.length; i += 4) {
            const n = (Math.random() * strength) | 0;
            data[i] = n;        // R
            data[i + 1] = n;    // G
            data[i + 2] = n;    // B
            data[i + 3] = 255;  // ✅ 노이즈 자체는 불투명
        }

        // 노이즈를 아주 약하게 "얹기"
        ctx.save();
        ctx.globalAlpha = 0.10; // 노이즈 강도 (0.05~0.15 추천)
        ctx.putImageData(noise, 0, 0);
        ctx.restore();

        // 3) (선택) 비네팅도 그대로 "얹기" OK
        const v = ctx.createRadialGradient(
            w / 2, h / 2, Math.min(w, h) * 0.2,
            w / 2, h / 2, Math.max(w, h) * 0.75
        );
        v.addColorStop(0, 'rgba(0,0,0,0)');
        v.addColorStop(1, 'rgba(0,0,0,0.55)');
        ctx.fillStyle = v;
        ctx.fillRect(0, 0, w, h);
    }


    let isDown = false;
    let last = null;

    function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        if (e.touches && e.touches[0]) {
            return { x: e.touches[0].clientX - rect.left, y: e.touches[0].clientY - rect.top };
        }
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    }

    function eraseStroke(from, to) {
        const radius = Number(brushEl.value);
        const softness = Number(softEl.value);

        ctx.globalCompositeOperation = 'destination-out';

        const dx = to.x - from.x;
        const dy = to.y - from.y;
        const dist = Math.hypot(dx, dy);
        const step = Math.max(2, radius * 0.25);
        const steps = Math.ceil(dist / step);

        for (let i = 0; i <= steps; i++) {
            const t = steps === 0 ? 0 : i / steps;
            const x = from.x + dx * t;
            const y = from.y + dy * t;

            const g = ctx.createRadialGradient(x, y, radius * (1 - softness), x, y, radius);
            g.addColorStop(0, 'rgba(0,0,0,1)');
            g.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle = g;
            ctx.beginPath();
            ctx.arc(x, y, radius, 0, Math.PI * 2);
            ctx.fill();
        }

        ctx.globalCompositeOperation = 'source-over';
    }

    function onDown(e) {
        isDown = true;
        const p = getPos(e);
        last = p;
        eraseStroke(p, p);
    }

    function onMove(e) {
        if (!isDown) return;
        const p = getPos(e);
        eraseStroke(last, p);
        last = p;
    }

    function onUp() {
        isDown = false;
        last = null;
    }

    canvas.addEventListener('mousedown', onDown);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onUp);

    canvas.addEventListener('touchstart', (e) => { e.preventDefault(); onDown(e); }, { passive: false });
    canvas.addEventListener('touchmove', (e) => { e.preventDefault(); onMove(e); }, { passive: false });
    canvas.addEventListener('touchend', onUp);
    canvas.addEventListener('touchcancel', onUp);

    function syncUI() {
        brushValEl.textContent = brushEl.value;
        softValEl.textContent = softEl.value;
    }
    brushEl.addEventListener('input', syncUI);
    softEl.addEventListener('input', syncUI);
    resetBtn.addEventListener('click', drawCover);
    syncUI();

    // (선택) cover 이미지 옵션은 비워두면 사용 안 함
    if (imageCoverUrl) {
        coverImg = new Image();
        coverImg.crossOrigin = "anonymous";
        coverImg.onload = () => drawCover();
        coverImg.src = imageCoverUrl;
    }

    window.addEventListener('resize', resize);
    resize();
</script>
</body>
</html>
